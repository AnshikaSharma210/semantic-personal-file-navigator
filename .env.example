# Embeddings: "local" (free, default) or "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional — only needed if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional — used only to phrase the answer from retrieved snippets
# Leave blank to return ranked files + excerpts with no LLM rewrite
OPENAI_CHAT_MODEL=gpt-4o-mini

# Hard limits (guardrails)
MAX_UPLOAD_MB=8
MAX_FILES_PER_LIBRARY=200
MAX_CHUNK_CHARS=900
#MAX_RESULTS=8
